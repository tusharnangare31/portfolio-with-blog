# Database Configuration
# Default is SQLite for local development. Set this for PostgreSQL in production.
# DATABASE_URL=postgresql://user:password@hostname:port/dbname

# Security
# Set a strong, secret token here for your Admin panel.
ADMIN_TOKEN=my_super_secret_admin_token

# CORS Origins
# Comma separated list of allowed origins. Add your Netlify URL here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://tusharnangare.netlify.app

# Contact Form — Discord Webhook (Optional)
# Create a webhook in your Discord server: Server Settings > Integrations > Webhooks > New Webhook
# Paste the URL here. If not set, contact messages will be logged to the console.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Site URL (for sitemap and RSS)
SITE_URL=https://tusharnangare.netlify.app
